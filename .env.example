# Copy to .env (or export in your shell). With no key set, everything runs in offline demo mode.
# Model routed through LiteLLM. Use "mock" to force the offline rule-based mode.
LLM_MODEL=anthropic/claude-sonnet-4-5
ANTHROPIC_API_KEY=
# If you switch LLM_MODEL to openai/..., set this instead:
OPENAI_API_KEY=
